#!/bin/sh
set -eu

url=""
destination=""
payload=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --output)
      [ "$#" -ge 2 ] || exit 2
      destination="$2"
      shift 2
      ;;
    --data)
      [ "$#" -ge 2 ] || exit 2
      payload="$2"
      shift 2
      ;;
    https://*)
      url="$1"
      shift
      ;;
    *)
      shift
      ;;
  esac
done

[ -n "$url" ] || exit 2
case "$url" in
  https://stats.fixture.invalid/api/install-events)
    [ -n "${BEEAPI_TEST_EVENT_FILE:-}" ] || exit 2
    printf '%s\n' "$payload" > "$BEEAPI_TEST_EVENT_FILE"
    exit 0
    ;;
esac

[ -n "${BEEAPI_TEST_ASSET_DIR:-}" ] || exit 2
[ -n "$destination" ] || exit 2
case "$url" in
  https://getbeeapi.com/*)
    [ "${BEEAPI_TEST_FAIL_MIRROR:-0}" != "1" ] || exit 22
    if [ "${BEEAPI_TEST_CORRUPT_MIRROR:-0}" = "1" ]; then
      case "$url" in
        *.sha256)
          printf '%064d\n' 0 > "$destination"
          exit 0
          ;;
      esac
    fi
    ;;
esac
cp "$BEEAPI_TEST_ASSET_DIR/${url##*/}" "$destination"
